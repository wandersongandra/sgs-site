---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';
import { site } from '../config';
import Preloader from '../components/Preloader.astro';
import Cursor from '../components/Cursor.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0D3457" />
    <link rel="icon" type="image/svg+xml" href="/logo-sgs-mark.svg" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduce-motion');
      }
      if (window.matchMedia('(pointer: fine)').matches) {
        document.documentElement.classList.add('has-fine-pointer');
      }
      if (sessionStorage.getItem('sgs-preloader-done') === '1') {
        document.documentElement.classList.add('preloader-done');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <Preloader />
    <Cursor />
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

---
import { site, whatsappUrl } from '../config';
import WaIcon from './WaIcon.astro';
---

<section class="section contact-block" id="contato" aria-labelledby="cta-title">
  <div class="container">
    <h2 id="cta-title" class="reveal">Fale sobre a sua operação</h2>
    <p class="lede reveal">
      WhatsApp {site.whatsappDisplay}.
    </p>
    <div class="contact-actions reveal">
      <a class="btn btn-primary" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
        <WaIcon />
        Falar no WhatsApp
      </a>
      <a class="btn btn-secondary" href={site.appLoginUrl} target="_blank" rel="noopener noreferrer">
        Acessar o sistema
      </a>
    </div>
  </div>
</section>

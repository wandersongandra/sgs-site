---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Value from '../components/Value.astro';
import Audience from '../components/Audience.astro';
import Modules from '../components/Modules.astro';
import Journey from '../components/Journey.astro';
import Offline from '../components/Offline.astro';
import Sophie from '../components/Sophie.astro';
import Security from '../components/Security.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="conteudo">
    <Hero />
    <Value />
    <Audience />
    <Modules />
    <Journey />
    <Offline />
    <Sophie />
    <Security />
    <Faq />
    <Cta />
  </main>
  <Footer />
</BaseLayout>

---
import { site, whatsappUrl } from '../config';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="#topo">
        <img src="/logo-sgs-mark.svg" alt="" width="28" height="28" />
        <span>{site.name}</span>
      </a>
      <p>Sistema de gestão de Segurança e Saúde do Trabalho.</p>
    </div>
    <div>
      <strong>Contato</strong>
      <ul>
        <li>
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
            WhatsApp {site.whatsappDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
        </li>
        <li>
          <a href="mailto:privacidade@sgsseguranca.com.br">privacidade@sgsseguranca.com.br</a>
        </li>
        <li>
          <a href="mailto:dpo@sgsseguranca.com.br">dpo@sgsseguranca.com.br</a>
        </li>
        <li>
          <a href={site.appLoginUrl} target="_blank" rel="noopener noreferrer">Acessar o sistema</a>
        </li>
      </ul>
    </div>
    <div>
      <strong>Páginas</strong>
      <ul>
        <li><a href="#modulos">Módulos</a></li>
        <li><a href="#jornada">Como funciona</a></li>
        <li><a href="#sophie">Sophie</a></li>
        <li><a href="#faq">Perguntas frequentes</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal-note">
    <p>© {new Date().getFullYear()} {site.name}.</p>
  </div>
</footer>

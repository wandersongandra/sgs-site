---
import { securityPoints } from '../data/content';
---

<section class="section" id="seguranca" aria-labelledby="seguranca-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="seguranca-title">Cada empresa no seu espaço. Cada acesso, no controle.</h2>
    </div>
    <dl class="spec-list">
      {
        securityPoints.map((s) => (
          <div class="reveal">
            <dt>{s.title}</dt>
            <dd>{s.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

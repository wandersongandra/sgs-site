---
import { audiences } from '../data/content';
---

<section class="section section-follow" aria-labelledby="publico-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Para quem é</p>
      <h2 id="publico-title">Do técnico na planta ao gestor no painel.</h2>
    </div>
    <div class="audience-grid">
      {
        audiences.map((a) => (
          <article class="card audience-card" data-spotlight>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

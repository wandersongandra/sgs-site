---
import { moduleGroups } from '../data/content';
---

<section class="block spec" id="modulos" aria-labelledby="modulos-title">
  <div class="container">
    <div class="block-head">
      <p class="kicker kicker-ink">Módulos</p>
      <h2 id="modulos-title">O que a operação de segurança encontra no mesmo sistema.</h2>
      <p>Escolha uma área. A lista ao lado é o produto, não uma tela.</p>
    </div>

    <div class="spec-layout">
      <div class="spec-tabs" role="tablist" aria-label="Áreas do SGS" data-mod-tabs>
        {
          moduleGroups.map((group, i) => (
            <button
              class="spec-tab"
              type="button"
              role="tab"
              id={`tab-${group.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${group.id}`}
              data-mod-tab={group.id}
            >
              <span>0{i + 1}</span>
              {group.title}
            </button>
          ))
        }
      </div>
      <div class="spec-stage">
      {
        moduleGroups.map((group, i) => (
          <div
            class="spec-panel"
            role="tabpanel"
            id={`panel-${group.id}`}
            aria-labelledby={`tab-${group.id}`}
            data-mod-panel={group.id}
            hidden={i !== 0}
          >
            <p class="spec-lead">{group.lead}</p>
            <ul class="spec-rows">
              {group.items.map((item) => (
                <li>
                  <div>
                    <strong>{item.name}</strong>
                    {item.full !== item.name && <em>{item.full}</em>}
                  </div>
                  <p>{item.desc}</p>
                </li>
              ))}
            </ul>
            <p class="spec-note">Recursos do produto. Esta lista não reproduz uma tela do sistema.</p>
          </div>
        ))
      }
      </div>
    </div>
  </div>
</section>

---
import { audiences } from '../data/content';
---

<section class="block audience-block" aria-labelledby="publico-title">
  <div class="container">
    <div class="block-head">
      <p class="kicker kicker-ink">Para quem é</p>
      <h2 id="publico-title">Do técnico na planta ao gestor no painel.</h2>
    </div>
    <dl class="who">
      {
        audiences.map((a) => (
          <div class="who-row">
            <dt>{a.title}</dt>
            <dd>{a.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

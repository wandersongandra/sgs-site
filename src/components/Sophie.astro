---
import { sophieTasks, sophieChat } from '../data/content';
---

<section class="section section-soft" id="sophie" aria-labelledby="sophie-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="sophie-title">Sophie analisa APR e PT e consulta os dados da empresa.</h2>
      <p>
        Também sugere DDS e lê checklists, com controle de acesso. O que ela gera é rascunho para alguém revisar.
      </p>
    </div>

    <div class="sophie-grid">
      <div class="sophie-intro reveal">
        <img src="/sophie-avatar.svg" alt="" width="72" height="72" />
        <div>
          <h3 class="sophie-name">Sophie</h3>
          <p class="sophie-note">
            Exemplo ilustrativo, sem dados de cliente.
          </p>
          <ul class="sophie-tasks" aria-label="O que a Sophie faz">
            {sophieTasks.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>

      <div
        class="chat reveal"
        data-sophie-chat
        data-chat={JSON.stringify(sophieChat)}
        aria-label="Demonstração ilustrativa de conversa"
      >
        {
          sophieChat.map((m, i) => (
            <div class={`chat-bubble ${m.role} is-in`} data-chat-bubble={i} data-full={m.text}>
              {m.text}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

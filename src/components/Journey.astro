---
import { journeySteps } from '../data/content';
---

<section class="book" id="jornada" aria-labelledby="jornada-title" data-journey>
  <div class="container book-intro">
    <p class="kicker kicker-ink">Do campo ao painel</p>
    <h2 id="jornada-title">Um checklist, lido de ponta a ponta.</h2>
    <p>As quatro etapas ficam na página. O fio só acompanha a leitura. Os desenhos são exemplo, não captura do sistema.</p>
  </div>

  <div class="book-steps" data-journey-steps>
    <svg class="book-svg" data-journey-thread viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path data-journey-path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <circle data-journey-bead r="5" fill="currentColor" cx="-40" cy="-40" />
    </svg>
    {
      journeySteps.map((step, i) => (
        <article class:list={['chapter', i === 2 && 'chapter-ink', i === 0 && 'is-active']} data-journey-step={i}>
          <div class="chapter-inner">
            <div class="n">{step.n}</div>
            <div class="chapter-copy">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
            <div class:list={['journey-frame', 'chapter-fig', i === 0 && 'is-active']} data-journey-frame={i}>
              {i === 0 && (
                <div class="fig fig-list">
                  <p>Checklist EPI · Frente A</p>
                  <ul>
                    <li>Capacete e óculos</li>
                    <li>Luva e calçado</li>
                    <li>Foto da evidência · 08:41</li>
                  </ul>
                </div>
              )}
              {i === 1 && (
                <div class="fig fig-list">
                  <p>Checklist EPI · aprovação</p>
                  <ul>
                    <li>Responsável técnico · assinou</li>
                    <li>Supervisor · pendente</li>
                  </ul>
                </div>
              )}
              {i === 2 && (
                <div class="fig fig-doc">
                  <p>checklist-epi-frente-a.pdf</p>
                  <strong>No acervo</strong>
                  <span>PDF de exemplo · verificação pública</span>
                </div>
              )}
              {i === 3 && (
                <div class="fig fig-list">
                  <p>Painel do exemplo</p>
                  <ul>
                    <li>1 checklist neste desenho</li>
                    <li>1 aprovação pendente</li>
                    <li>1 arquivo no acervo</li>
                  </ul>
                  <span>Números ilustrativos, não medição de cliente.</span>
                </div>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

---
import { site, whatsappUrl } from '../config';
---

<footer class="site-footer footer-v4">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="#topo">
        <img src="/logo-sgs-mark.svg" alt="" width="36" height="36" />
        <span>{site.name}</span>
      </a>
      <p>
        Sistema de gestão de Segurança e Saúde do Trabalho para operação, conformidade e evidências.
      </p>
    </div>
    <div>
      <strong>Contato</strong>
      <ul>
        <li>
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
            WhatsApp {site.whatsappDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
        </li>
        <li>
          <a href={site.appLoginUrl} target="_blank" rel="noopener noreferrer">Acessar o sistema</a>
        </li>
      </ul>
    </div>
    <div>
      <strong>Institucional</strong>
      <ul>
        <li><a href="#modulos">Módulos</a></li>
        <li><a href="#faq">Perguntas frequentes</a></li>
        <li><span>{site.plansLabel}</span></li>
      </ul>
    </div>
  </div>
  <div class="container footer-wordmark" data-footer-wordmark aria-hidden="true">
    <span>SGS</span>
  </div>
  <div class="container legal-note">
    <p>
      © {new Date().getFullYear()} {site.name}.
    </p>
  </div>
</footer>

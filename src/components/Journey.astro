---
import { journeySteps } from '../data/content';
---

<section class="section section-dark journey" id="jornada" aria-labelledby="jornada-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Como funciona</p>
      <h2 id="jornada-title">Do registro no campo aos indicadores.</h2>
    </div>
    <ol class="steps-grid">
      {
        journeySteps.map((step) => (
          <li class="step-card reveal">
            <div class="n">{step.n}</div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
import { securityPoints } from '../data/content';
---

<section class="section" id="seguranca" aria-labelledby="seguranca-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="seguranca-title">Isolamento entre empresas e controle de acesso</h2>
    </div>
    <ul class="security-list">
      {
        securityPoints.map((s) => (
          <li class="reveal">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import { moduleGroups } from '../data/content';
---

<section class="section" id="modulos" aria-labelledby="modulos-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="modulos-title">O que o SGS cobre</h2>
      <p>Os registros da operação, organizados por área.</p>
    </div>

    <div class="mod-tabs reveal" role="tablist" aria-label="Áreas do SGS" data-mod-tabs>
      {
        moduleGroups.map((group, i) => (
          <button
            class="mod-tab"
            type="button"
            role="tab"
            id={`tab-${group.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${group.id}`}
            data-mod-tab={group.id}
          >
            {group.title}
          </button>
        ))
      }
    </div>

    {
      moduleGroups.map((group, i) => (
        <div
          class:list={['mod-panel', i === 0 && 'is-active']}
          role="tabpanel"
          id={`panel-${group.id}`}
          aria-labelledby={`tab-${group.id}`}
          data-mod-panel={group.id}
          hidden={i !== 0}
        >
          <p class="mod-lead">{group.lead}</p>
          <ul class="mod-list">
            {group.items.map((item) => (
              <li>
                <div>
                  <strong>{item.name}</strong>
                  {item.full !== item.name && <span class="full">{item.full}</span>}
                </div>
                <p>{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

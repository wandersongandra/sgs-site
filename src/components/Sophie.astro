---
import { sophieTasks, sophieChat } from '../data/content';
---

<section class="block sophie-block" id="sophie" aria-labelledby="sophie-title">
  <div class="container sophie-layout">
    <div>
      <p class="kicker kicker-ink">Sophie IA</p>
      <h2 id="sophie-title">Assistência dentro do sistema, com o vocabulário da operação.</h2>
      <p class="lede-quiet">
        Ela ajuda a analisar APR e PT, sugerir DDS, ler checklists e conversar com dados da empresa, com controle de acesso.
        O diálogo abaixo é um exemplo, não um atendimento real.
      </p>
      <ul class="task-list" aria-label="Capacidades da Sophie">
        {sophieTasks.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <div class="transcript" data-sophie-chat aria-label="Demonstração ilustrativa de conversa">
      <p class="transcript-label">
        <img src="/sophie-avatar.svg" alt="" width="36" height="36" />
        Exemplo de conversa
      </p>
      {
        sophieChat.map((m, i) => (
          <p class:list={['transcript-line', m.role, 'is-in']} data-chat-bubble={i} data-full={m.text}>
            {m.text}
          </p>
        ))
      }
    </div>
  </div>
</section>

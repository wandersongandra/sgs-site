---
import { journeySteps } from '../data/content';
---

<section class="section" id="jornada" aria-labelledby="jornada-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="jornada-title">Como funciona</h2>
    </div>
    <ol class="steps">
      {
        journeySteps.map((step) => (
          <li class="reveal">
            <div class="n">{step.n}</div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
import { whatsappUrl } from '../config';
import WaIcon from './WaIcon.astro';
---

<header class="site-header" data-header>
  <div class="container nav">
    <a class="brand" href="#topo" aria-label="SGS Segurança, início">
      <img src="/logo-sgs-mark.svg" alt="" width="28" height="28" />
      <span>SGS Segurança</span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Abrir menu"
    >
      <span></span>
    </button>
    <ul class="nav-links" id="menu-principal" data-nav-links>
      <li><a href="#jornada">Como funciona</a></li>
      <li><a href="#modulos">Módulos</a></li>
      <li><a href="#sophie">Sophie</a></li>
      <li><a href="#faq">Perguntas</a></li>
      <li>
        <a class="btn btn-primary" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          <WaIcon />
          <span class="nav-wa-label">WhatsApp</span>
        </a>
      </li>
    </ul>
  </div>
</header>

---
import { journeySteps } from '../data/content';
---

<section class="section section-dark journey" id="jornada" aria-labelledby="jornada-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="jornada-title">Do campo ao painel, o registro não se perde.</h2>
      <p>O técnico registra no celular. A assinatura fica no documento. A evidência chega à auditoria. O gestor acompanha no painel.</p>
    </div>

    <div class="journey-pin" data-journey>
      <div class="journey-progress" data-journey-progress aria-hidden="true">
        <span data-journey-bar></span>
      </div>

      <div class="journey-steps" data-journey-steps>
        <p class="journey-kicker">O caminho do registro</p>
        {
          journeySteps.map((step, i) => (
            <article class:list={['journey-step', i === 0 && 'is-active']} data-journey-step={i}>
              <div class="n">{step.n}</div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>

      <div class="journey-visual" data-journey-visual aria-hidden="true">
        <!-- 0: Phone checklist with photo -->
        <div class="journey-frame is-active" data-journey-frame="0">
          <div class="jf-phone">
            <div class="jf-notch"></div>
            <div class="jf-screen">
              <div class="jf-title">Checklist EPI · Frente A</div>
              <div class="jf-check is-done"><span>✓</span> Capacete e óculos</div>
              <div class="jf-check is-done"><span>✓</span> Luva e calçado</div>
              <div class="jf-check is-done"><span>✓</span> Área sinalizada</div>
              <div class="jf-photo">
                <div class="jf-photo-img"></div>
                <span>Foto da evidência · 08:41</span>
              </div>
              <div class="jf-footer-bar">Salvar e sincronizar</div>
            </div>
          </div>
        </div>

        <!-- 1: Signature flow -->
        <div class="journey-frame" data-journey-frame="1">
          <div class="jf-card">
            <div class="jf-card-head">Aprovação e assinatura</div>
            <div class="jf-sig-row">
              <div>
                <strong>Responsável técnico</strong>
                <span class="status status-ok">Assinou</span>
              </div>
              <svg class="jf-sig" viewBox="0 0 160 48" fill="none" aria-hidden="true">
                <path class="sig-path" d="M8 30 C24 8, 40 42, 56 22 S88 10, 104 28 136 18, 152 26" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="jf-sig-row muted">
              <div>
                <strong>Supervisor</strong>
                <span class="status status-warn">Pendente</span>
              </div>
              <div class="jf-sig-blank">Aguardando</div>
            </div>
            <div class="jf-meta">Horário · 08:42</div>
          </div>
        </div>

        <!-- 2: PDF / evidence document -->
        <div class="journey-frame" data-journey-frame="2">
          <div class="jf-doc">
            <div class="jf-doc-bar">
              <span></span><span></span><span></span>
              <em>evidencia-pt-frente-a.pdf</em>
            </div>
            <div class="jf-doc-body">
              <div class="jf-doc-title">Permissão de Trabalho</div>
              <div class="jf-doc-line w80"></div>
              <div class="jf-doc-line w60"></div>
              <div class="jf-doc-line w90"></div>
              <div class="jf-doc-stamp">PDF · v3 · Pronto</div>
              <div class="jf-doc-badges">
                <span class="status status-ok">Verificação pública</span>
                <span class="status status-ok">Assinado</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3: Indicators chart -->
        <div class="journey-frame" data-journey-frame="3">
          <div class="jf-chart-card">
            <div class="jf-card-head">Painel do gestor</div>
            <div class="jf-kpis">
              <div><strong>Checklists</strong><span>Em dia no painel</span></div>
              <div><strong>APR</strong><span>Aguardando aprovação</span></div>
              <div><strong>NC</strong><span>Em tratativa</span></div>
            </div>
            <div class="jf-bars">
              <span style="--h:72%"></span>
              <span style="--h:88%"></span>
              <span style="--h:64%"></span>
              <span style="--h:96%"></span>
              <span style="--h:80%"></span>
              <span style="--h:70%"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

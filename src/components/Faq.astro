---
import { faqs } from '../data/content';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Perguntas objetivas.</h2>
    </div>
    <div style="max-width: 46rem;">
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

---
import { securityPoints } from '../data/content';
---

<section class="section security-section" id="seguranca" aria-labelledby="seguranca-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Segurança e privacidade</p>
      <h2 id="seguranca-title">Isolamento entre empresas, acesso controlado e trilha de auditoria.</h2>
      <ul class="contact-list">
        <li>
          <a href="mailto:suporte@sgsseguranca.com.br">suporte@sgsseguranca.com.br</a>
        </li>
        <li>
          <a href="mailto:privacidade@sgsseguranca.com.br">privacidade@sgsseguranca.com.br</a>
        </li>
        <li>
          <a href="mailto:dpo@sgsseguranca.com.br">dpo@sgsseguranca.com.br</a>
        </li>
      </ul>
    </div>

    <div class="security-grid">
      {
        securityPoints.map((s) => (
          <article class="sec-card reveal">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

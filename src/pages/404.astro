---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaIcon from '../components/WaIcon.astro';
import { site, whatsappUrl } from '../config';
---
<BaseLayout title="Página não encontrada | SGS Segurança" description="A página que você procurou não existe." noindex path="/404">
  <main id="conteudo">
    <section class="page-empty" aria-labelledby="nf-title">
      <div class="container">
        <a class="brand" href="/">
          <img src="/logo-sgs-mark.svg" alt="" width="28" height="28" />
          <span>{site.name}</span>
        </a>
        <h1 id="nf-title">Página não encontrada.</h1>
        <p class="lede">O endereço pode ter mudado ou estar incorreto.</p>
        <div class="contact-actions">
          <a class="btn btn-primary" href="/">Voltar ao início</a>
          <a class="btn btn-secondary" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
            <WaIcon />
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

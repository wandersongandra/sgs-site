---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';
import '../styles/edition.css';
import { site } from '../config';
import Preloader from '../components/Preloader.astro';
import fontLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Força noindex (ex.: 404), independente do PUBLIC_INDEXABLE. */
  noindex?: boolean;
  path?: string;
}

const { title = site.title, description = site.description, noindex = false, path = '/' } = Astro.props;
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !noindex;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-image.png', site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#org`,
      name: site.name,
      url: `${site.url}/`,
      logo: new URL('/icon-512.png', site.url).href,
      email: site.supportEmail,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: '+55-31-8693-7268',
        availableLanguage: 'pt-BR',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'SGS Segurança',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'pt-BR',
      url: `${site.url}/`,
      description,
      publisher: { '@id': `${site.url}/#org` },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0D3457" />
    <style is:inline>
      .preloader{display:none!important;visibility:hidden!important;pointer-events:none!important}
    </style>
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/logo-sgs-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SGS Segurança: gestão de Segurança e Saúde do Trabalho" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduce-motion');
      }
      if (window.matchMedia('(pointer: fine)').matches) {
        document.documentElement.classList.add('has-fine-pointer');
      }
      try {
        if (sessionStorage.getItem('sgs-preloader-done') === '1') {
          document.documentElement.classList.add('preloader-done');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="edition">
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <div class="motion-control" role="region" aria-label="Controle de movimento">
      <label class="motion-pause-label">
        <input type="checkbox" id="pausar-movimento" class="motion-pause-input" data-motion-toggle />
        <span class="motion-pause-icon" aria-hidden="true"></span>
        <span class="when-play">Pausar movimento</span>
        <span class="when-pause">Retomar movimento</span>
      </label>
    </div>
    <Preloader />
    <div class="section-passage" data-passage aria-hidden="true"></div>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

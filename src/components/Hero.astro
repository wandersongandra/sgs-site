---
import { whatsappUrl } from '../config';
import WaIcon from './WaIcon.astro';

const stages = [
  {
    n: '01',
    k: 'Campo',
    title: 'Registra no celular',
    note: 'Exemplo de interface',
  },
  {
    n: '02',
    k: 'Aprovação',
    title: 'Assina e aprova',
    note: 'Exemplo de interface',
  },
  {
    n: '03',
    k: 'Acervo',
    title: 'Vira evidência',
    note: 'Exemplo de interface',
  },
  {
    n: '04',
    k: 'Painel',
    title: 'Aparece no painel',
    note: 'Números deste desenho, não de um cliente',
  },
];
---

<section class="sheet" id="topo" data-hero aria-labelledby="hero-title">
  <div class="sheet-copy">
    <p class="kicker">Segurança e Saúde do Trabalho</p>
    <h1 id="hero-title">Do checklist no celular ao painel de conformidade.</h1>
    <p class="sheet-lede">
      O técnico registra checklist, APR ou PT no celular. O SGS leva esse registro para aprovação,
      para o acervo e para o painel de quem acompanha a operação.
    </p>
    <a class="sheet-cta" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
      <WaIcon />
      Falar no WhatsApp
    </a>
    <p class="sheet-note">Ilustração de exemplo. Não é uma captura do sistema nem um resultado de cliente.</p>
  </div>

  <div class="rail" data-hero-stage>
    <p class="rail-hint">Deslize as quatro etapas</p>
    <svg class="rail-svg" data-hero-thread aria-hidden="true">
      <path data-hero-path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <circle data-hero-bead r="4.5" fill="currentColor" cx="-20" cy="-20" />
    </svg>
    <ol class="rail-list" tabindex="0" aria-label="Etapas de exemplo. No celular, deslize para o lado.">
      {
        stages.map((stage, i) => (
          <li class="stage" data-rail-step={i}>
            <div class="stage-top">
              <span class="stage-n" data-rail-mark>{stage.n}</span>
              <span class="stage-k">{stage.k}</span>
            </div>
            <p class="stage-title">{stage.title}</p>
            {i === 0 && (
              <ul class="ticks">
                <li>Capacete e óculos</li>
                <li>Luva e calçado</li>
                <li>Foto da evidência</li>
              </ul>
            )}
            {i === 1 && (
              <ul class="signs">
                <li><span>Responsável técnico</span><b>Assinou</b></li>
                <li><span>Supervisor</span><b>Pendente</b></li>
              </ul>
            )}
            {i === 2 && (
              <div class="doc">
                <p>checklist-epi-frente-a.pdf</p>
                <i>EXEMPLO</i>
              </div>
            )}
            {i === 3 && (
              <ul class="counts">
                <li><b>1</b><span>checklist no exemplo</span></li>
                <li><b>1</b><span>aprovação pendente</span></li>
                <li><b>1</b><span>arquivo no acervo</span></li>
              </ul>
            )}
            <p class="stage-note">{stage.note}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

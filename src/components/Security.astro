---
import { securityPoints } from '../data/content';
---

<section class="block trust" id="seguranca" aria-labelledby="seguranca-title">
  <div class="container trust-layout">
    <div>
      <p class="kicker kicker-ink">Confiança</p>
      <h2 id="seguranca-title">Isolamento, acesso e trilha no desenho do produto.</h2>
      <p class="lede-quiet">
        Contatos do produto: suporte@sgsseguranca.com.br e privacidade@sgsseguranca.com.br /
        dpo@sgsseguranca.com.br.
      </p>
      <div class="shield-wrap" aria-hidden="true" data-security-stage>
        <svg class="shield-svg" viewBox="0 0 200 220" fill="none" data-shield>
          <path class="shield-outline" d="M100 18 L172 48 V108 C172 156 140 190 100 206 C60 190 28 156 28 108 V48 Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
          <path class="shield-lock" d="M86 108 V96 C86 88 92 82 100 82 C108 82 114 88 114 96 V108" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <rect class="shield-lock-body" x="78" y="108" width="44" height="34" rx="6" stroke="currentColor" stroke-width="3" />
          <path class="shield-check" d="M88 124 L96 132 L114 112" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
    <ol class="trust-list">
      {
        securityPoints.map((s, i) => (
          <li>
            <span>0{i + 1}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

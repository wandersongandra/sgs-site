---
import { audiences } from '../data/content';
---

<section class="section audience" aria-labelledby="publico-title">
  <div class="container audience-layout">
    <div class="section-head reveal">
      <h2 id="publico-title">Do técnico na planta ao gestor no painel.</h2>
      <p>Cada perfil vê e faz o que a função pede.</p>
    </div>
    <dl class="role-list">
      {
        audiences.map((a) => (
          <div class="role-row reveal" data-spotlight>
            <dt>{a.title}</dt>
            <dd>{a.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

---
import { site, whatsappUrl } from '../config';
import WaIcon from './WaIcon.astro';
---

<section class="close" id="contato" aria-labelledby="cta-title" data-cta>
  <div class="container close-inner">
    <p class="kicker">Próximo passo</p>
    <h2 id="cta-title">Quer conhecer o SGS na sua operação?</h2>
    <p>Fale conosco no WhatsApp {site.whatsappDisplay}. {site.plansLabel}.</p>
    <a class="sheet-cta sheet-cta-light" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
      <WaIcon />
      Abrir WhatsApp
    </a>
    <p class="close-login">
      Já usa o SGS?
      <a href={site.appLoginUrl} target="_blank" rel="noopener noreferrer">Acessar o sistema</a>
    </p>
  </div>
</section>

---
import { audiences } from '../data/content';
---

<section class="section" style="padding-top: 0;" aria-labelledby="publico-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Para quem é</p>
      <h2 id="publico-title" style="text-wrap:balance; max-width:18ch;">Do técnico na planta ao gestor no painel.</h2>
    </div>
    <div class="audience-grid">
      {
        audiences.map((a) => (
          <article class="card" data-spotlight>
            <h3>{a.title}</h3>
            <p style="margin: 0.45rem 0 0; color: var(--ink-muted); font-size: 0.92rem;">{a.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

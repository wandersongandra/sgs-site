  heart: 'M12 20s-7-4.4-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.6-7 10-7 10z',
  hardhat: 'M4 14h16v2H4z M6 14a6 6 0 0112 0 M12 5v3',
